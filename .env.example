# ─────────────────────────────────────────────────────────────────────────
# ROOT .env — used by docker compose AND as the reference for Vercel env.
# Copy to `.env` for local Docker use. Vercel project settings are separate.
# ─────────────────────────────────────────────────────────────────────────

# ── Frontend (Vercel project settings, NOT docker compose) ────────────────
# Backend origin for API calls in production (no trailing slash).
# Leave empty for local dev (Vite proxies /api → localhost:5000).
# Example: VITE_API_URL=https://api.example.com
VITE_API_URL=

# ── docker compose (used by `docker compose up`) ──────────────────────────
# Local Postgres password (dev only — never reuse in production).
POSTGRES_PASSWORD=postgres

# JWT secrets (≥ 32 chars, random). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Frontend origin the API will allow (CORS) and redirect to after OAuth.
CLIENT_URL=http://localhost:5173

# Secure cookies over HTTPS only.
COOKIE_SECURE=false

# SameSite for auth cookies: 'lax' (same-site) or 'none' (cross-site,
# frontend and API on different domains — requires COOKIE_SECURE=true).
COOKIE_SAMESITE=lax

# Admin self-registration gate. Leave empty to disable admin signup.
ADMIN_REGISTER_CODE=

# SMTP (optional; mail is logged to console when empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ORABI Restaurant <noreply@orabi.local>"

# Cloudinary (optional; files go to local disk when empty).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Social auth (optional; buttons hidden when empty).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback
