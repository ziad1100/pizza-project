# Server
NODE_ENV=development
PORT=5000

# Mongo: legacy â€” kept only until the one-time mongoâ†’postgres data migration
# script (server/src/scripts/migrate-mongo-to-pg.ts) has been run, then removed.
MONGO_URI=mongodb://127.0.0.1:27017/pizza

# Supabase / PostgreSQL (source of truth)
# Local (self-hosted via `supabase start`): see `supabase status`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Redis (cache layer â€” optional; API degrades to DB-only when empty/unreachable)
REDIS_URL=

# JWT — REQUIRED, no defaults. The server refuses to start unless both secrets are
# set and are not the legacy dev placeholders. Generate real random values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
COOKIE_SECURE=false

# CORS
CLIENT_URL=http://localhost:5173

# Admin self-registration gate (register page "Account type = Admin").
# Secret code that must be supplied to register an admin account.
# Leave empty to disable admin self-registration entirely.
ADMIN_REGISTER_CODE=

# Rate limiting (optional knobs; defaults shown)
AUTH_WINDOW_MS=900000
AUTH_LIMIT=20
SUBSCRIBE_WINDOW_MS=900000
SUBSCRIBE_LIMIT=10
CONTACT_WINDOW_MS=3600000
CONTACT_LIMIT=10
ADMIN_WINDOW_MS=900000
ADMIN_API_LIMIT=200
API_WINDOW_MS=900000
API_LIMIT=300

# Uploads (cloudinary: optional â€” local disk used when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mailer (nodemailer â€” dev fallback logs to console when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ORABI Restaurant <noreply@orabi.local>"

# Social auth (buttons hidden when empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# PRODUCTION CHECKLIST
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# 1. NODE_ENV=production
# 2. DATABASE_URL â€” Supabase/PostgreSQL: for self-hosted use
#    https://supabase.com/docs/guides/self-hosting; for the cloud, use the
#    "Session pooler" connection string from Project Settings â†’ Database.
#    SUPABASE_SERVICE_ROLE_KEY â€” server-only secret (never expose to the client).
# 3. REDIS_URL â€” required for the cache layer and BullMQ queues.
# 4. JWT_ACCESS_SECRET / JWT_REFRESH_SECRET â€” long random strings.
#    Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 5. COOKIE_SECURE=true â€” refresh cookie will only be sent over HTTPS.
# 6. CLIENT_URL â€” public HTTPS origin of the frontend (e.g. https://pizzahouse.example.com).
# 7. SMTP_* â€” real mail service (SMTP host/port/user/pass). Without them,
#    order/review/contact emails are only logged to stdout.
# 8. CLOUDINARY_* â€” set all three to upload media to Cloudinary;
#    otherwise files are stored on the local disk in server/src/uploads.
# 9. GOOGLE_*/FACEBOOK_* â€” provider client id/secret + public HTTPS callback URLs
#    registered in the provider dashboards. Social buttons stay hidden when empty.
# 10. Whitelisted CORS origins come from CLIENT_URL only â€” keep it exact.
# 11. Run `npm run seed` (workspace server) once against the real DB to
#     create roles/users (admin@pizzahouse.dev / Pizza123! â€” CHANGE THIS PASSWORD).
#     Seeding is DESTRUCTIVE: it wipes categories, products, users, etc.
# 12. Build artifacts: `npm run build` (client dist) + `npm run build:server`
#     (server/dist/server.js). `npm start` serves the SPA from client/dist
#     on PORT (default 5000) â€” or containerize via Docker (see README).
# 13. Reverse proxy: terminate TLS (e.g. Nginx/Caddy/Cloudflare), forward
#     / to the Node server, and disable buffering for streaming endpoints if used.
