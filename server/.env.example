# Server
NODE_ENV=development
PORT=5000

# Mongo: point at a persistent DB. Docker Mongo: mongodb://127.0.0.1:27017/pizza
# When empty, mongodb-memory-server is used for dev (persistent under server/.data/db;
# it is never wiped on shutdown).
MONGO_URI=

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
COOKIE_SECURE=false

# CORS
CLIENT_URL=http://localhost:5173

# Admin self-registration gate (register page "Account type = Admin").
# Secret code that must be supplied to register an admin account.
# Leave empty to disable admin self-registration entirely.
ADMIN_REGISTER_CODE=

# Uploads (cloudinary: optional — local disk used when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mailer (nodemailer — dev fallback logs to console when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ORABI Restaurant <noreply@orabi.local>"

# Social auth (buttons hidden when empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# ────────────────────────────────────────────────────────────
# PRODUCTION CHECKLIST
# ────────────────────────────────────────────────────────────
# 1. NODE_ENV=production
# 2. MONGO_URI — real MongoDB (e.g. Atlas) connection string.
#    NOTE: when MONGO_URI is empty the server boots mongodb-memory-server,
#    which seeds an EMPTY database — do not run like that in production.
# 3. JWT_ACCESS_SECRET / JWT_REFRESH_SECRET — long random strings.
#    Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 4. COOKIE_SECURE=true — refresh cookie will only be sent over HTTPS.
# 5. CLIENT_URL — public HTTPS origin of the frontend (e.g. https://pizzahouse.example.com).
# 6. SMTP_* — real mail service (SMTP host/port/user/pass). Without them,
#    order/review/contact emails are only logged to stdout.
# 7. CLOUDINARY_* — set all three to upload media to Cloudinary;
#    otherwise files are stored on the local disk in server/src/uploads.
# 8. GOOGLE_*/FACEBOOK_* — provider client id/secret + public HTTPS callback URLs
#    registered in the provider dashboards. Social buttons stay hidden when empty.
# 9. Whitelisted CORS origins come from CLIENT_URL only — keep it exact.
# 10. Run `npm run seed` (workspace server) once against the real DB to
#     create roles/users (admin@pizzahouse.dev / Pizza123! — CHANGE THIS PASSWORD).
#     Seeding is DESTRUCTIVE: it wipes categories, products, users, etc.
# 11. Build artifacts: `npm run build` (client dist) + `npm run build:server`
#     (server/dist/server.js). `npm start` serves the SPA from client/dist
#     on PORT (default 5000) — or containerize via Docker (see README).
# 12. Reverse proxy: terminate TLS (e.g. Nginx/Caddy/Cloudflare), forward
#     / to the Node server, and disable buffering for streaming endpoints if used.
