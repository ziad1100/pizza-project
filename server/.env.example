# Server
NODE_ENV=development
PORT=5000

# PostgreSQL (Docker): `docker compose up -d postgres`, then point here.
# Dev DB URL (matches docker-compose.yml defaults):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pizza

# Redis (cache layer + BullMQ — optional; API degrades to DB-only when empty/unreachable)
REDIS_URL=redis://127.0.0.1:6379

# JWT — REQUIRED, no defaults. The server refuses to start unless both secrets are
# set and are not the legacy dev placeholders. Generate real random values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
COOKIE_SECURE=false
# SameSite for auth cookies: 'lax' (frontend + API on the same site) or 'none'
# (separate domains, e.g. Vercel frontend + api.example.com). 'none' forces
# Secure=true and requires HTTPS.
COOKIE_SAMESITE=lax

# CORS
CLIENT_URL=http://localhost:5173

# Admin self-registration gate (register page "Account type = Admin").
# Secret code that must be supplied to register an admin account.
# Leave empty to disable admin self-registration entirely.
ADMIN_REGISTER_CODE=

# Rate limiting (optional knobs; defaults shown)
AUTH_WINDOW_MS=900000
AUTH_LIMIT=20
SUBSCRIBE_WINDOW_MS=900000
SUBSCRIBE_LIMIT=10
CONTACT_WINDOW_MS=3600000
CONTACT_LIMIT=10
ADMIN_WINDOW_MS=900000
ADMIN_API_LIMIT=200
API_WINDOW_MS=900000
API_LIMIT=300
REVIEW_WINDOW_MS=600000
REVIEW_LIMIT=20

# Uploads (cloudinary: optional — local disk used when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mailer (nodemailer — dev fallback logs to console when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ORABI Restaurant <noreply@orabi.local>"

# Social auth (buttons hidden when empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# ─────────────────────────────────────────────────────────────────────────
# PRODUCTION CHECKLIST
# ─────────────────────────────────────────────────────────────────────────
# 1. NODE_ENV=production
# 2. DATABASE_URL — point at the project's own Postgres (Docker `postgres`
#    service or any managed PG). No cloud service required.
# 3. REDIS_URL — required for the cache layer and BullMQ queues.
# 4. JWT_ACCESS_SECRET / JWT_REFRESH_SECRET — long random strings.
#    Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 5. COOKIE_SECURE=true — refresh cookie will only be sent over HTTPS.
#    If the frontend and API live on DIFFERENT domains (Vercel + api.example.com),
#    also set COOKIE_SAMESITE=none so the refresh cookie survives cross-site requests.
# 6. CLIENT_URL — public HTTPS origin of the frontend (e.g. https://pizzahouse.example.com).
# 7. SMTP_* — real mail service (SMTP host/port/user/pass). Without them,
#    order/review/contact emails are only logged to stdout.
# 8. CLOUDINARY_* — set all three to upload media to Cloudinary;
#    otherwise files are stored on the local disk in server/src/uploads.
# 9. GOOGLE_*/FACEBOOK_* — provider client id/secret + public HTTPS callback URLs
#    registered in the provider dashboards. Social buttons stay hidden when empty.
# 10. Whitelisted CORS origins come from CLIENT_URL only — keep it exact.
# 11. Run `npm run seed` (workspace server) once against the real DB to
#     create roles/users (admin@pizzahouse.dev / Pizza123! — CHANGE THIS PASSWORD).
#     Seeding is idempotent: it skips when data already exists, unless
#     SEED_RESET=1 forces a full wipe and reseed.
# 12. Build artifacts: `npm run build` (client dist) + `npm run build:server`
#     (server/dist/server.js). `npm start` serves the SPA from client/dist
#     on PORT (default 5000) — or containerize via Docker (see README).
# 13. Reverse proxy: terminate TLS (e.g. Nginx/Caddy/Cloudflare), forward
#     / to the Node server, and disable buffering for streaming endpoints if used.
# 14. `npm run seed` in production seeds the MENU/CATALOG only — demo users,
#     demo orders and demo carts are skipped (SEED_RESET is hard-blocked).
#     Create the first admin with ADMIN_REGISTER_CODE from the register page.